# Salin file ini menjadi .env.local lalu isi nilainya.
# Isi juga variabel yang sama di Vercel: Project > Settings > Environment Variables.
#
# PENTING: semua variabel di bawah hanya dipakai di SERVER.
# JANGAN beri awalan NEXT_PUBLIC_ supaya tidak terkirim ke browser.
#
# Lokasi di dashboard Supabase: Project Settings > API (atau API Keys).
# Jika proyekmu masih memakai key lama, pakai "anon" untuk PUBLISHABLE
# dan "service_role" untuk SECRET.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Fitur AI (US-14 dan US-50). Endpoint kompatibel OpenAI chat/completions.
ENDPOINT=
API_KEY=
AI_MODEL=

# Opsional: alamat situs untuk sitemap, robots, dan Open Graph.
SITE_URL=
